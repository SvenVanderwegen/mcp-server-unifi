# Settings for docker-compose.yml (per-user mode). In Portainer, enter these as
# the stack's environment variables; they end up in stack.env.

# --- Traefik routing ----------------------------------------------------------
SUBDOMAIN=unifi
DOMAIN_NAME=docker.example.com

# --- Per-user login (MCP_AUTH_MODE=user_key, the docker-compose.yml default) -
# The https:// address clients reach, without /mcp. Must match the Traefik host.
MCP_PUBLIC_URL=https://unifi.docker.example.com
# Encrypts the stored UniFi API keys. Generate with: openssl rand -hex 32
# For rotation, put the new secret first and keep the old one after a comma.
MCP_SECRET_KEY=replace-me-with-openssl-rand-hex-32

# Leave UNIFI_API_KEY / UNIFI_API_KEYS unset: the server refuses to start with a
# server-wide key in this mode, because every call must use the caller's own key.

# --- Or: Microsoft 365 sign-in with shared keys (docs/entra-deployment.md) ----
# MCP_AUTH_MODE=entra
# MCP_ENTRA_TENANT_ID=00000000-0000-0000-0000-000000000000
# MCP_ENTRA_CLIENT_ID=00000000-0000-0000-0000-000000000000
# MCP_ENTRA_CLIENT_SECRET=replace-me
# One key per Fabric, JSON list:
# UNIFI_API_KEYS=[{"key":"replace-me","label":"fabric-a"},{"key":"replace-me","label":"fabric-b"}]

# --- Optional -----------------------------------------------------------------
# Token lifetimes and how often a stored key is re-checked against api.ui.com.
# MCP_OAUTH_ACCESS_TOKEN_TTL=3600
# MCP_OAUTH_REFRESH_TOKEN_TTL=2592000
# MCP_OAUTH_REVALIDATE_INTERVAL=900
# Hosts a dynamically registering client (Claude) may redirect to.
# MCP_OAUTH_ALLOWED_REDIRECT_HOSTS=claude.ai,claude.com,global.consent.azure-apim.net,.consent.azure-apim.net,localhost,127.0.0.1

# Pre-registered client for Microsoft 365 Copilot (Teams Developer Portal OAuth
# client registration). Copilot does not register itself.
# MCP_OAUTH_CLIENT_ID=m365-copilot
# MCP_OAUTH_CLIENT_SECRET=replace-me-with-openssl-rand-hex-32
# MCP_OAUTH_CLIENT_REDIRECT_URIS=https://teams.microsoft.com/api/platform/v1.0/oAuthRedirect
# MCP_OAUTH_CLIENT_AUTH_METHOD=client_secret_post

# Write kill-switches of the upstream server. docker-compose.yml turns the
# connector relay on; Protect mutations are on by default.
# UNIFI_PROTECT_MUTATIONS_ENABLED=false
